{
    "name": "openppc/openppc-site-check-dev",
    "description": "WordPress coding standards for the OpenPPC Site Check plugin, every package pinned. Not part of the plugin.",
    "license": "MIT",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
        "phpcompatibility/php-compatibility": "9.3.5",
        "phpcompatibility/phpcompatibility-paragonie": "1.3.4",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "phpcsstandards/phpcsextra": "1.5.1",
        "phpcsstandards/phpcsutils": "1.2.3",
        "squizlabs/php_codesniffer": "3.13.6",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
